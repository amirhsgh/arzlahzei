generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  currency
  gold
  coin
  crypto
}

enum ArticleStatus {
  draft
  published
}

enum AdType {
  banner
  sidebar
  inline
  popup
  native
  video
  sticky_footer
  sticky_header
  between_content
  fullscreen_interstitial
}

enum AdPosition {
  header
  footer
  sidebar
  between_prices
  between_articles
  between_content
  above_fold
  below_fold
  in_content
}

enum DeviceTarget {
  all
  mobile
  desktop
}

enum UserRole {
  admin
  editor
}

model Price {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  nameEn        String
  category      Category
  currentPrice  Float          @default(0)
  previousPrice Float          @default(0)
  changePercent Float          @default(0)
  changeAmount  Float          @default(0)
  high24h       Float          @default(0)
  low24h        Float          @default(0)
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())
  history       PriceHistory[]

  @@index([category])
  @@index([slug])
}

model PriceHistory {
  id      String   @id @default(cuid())
  priceId String
  price   Float
  date    DateTime
  open    Float    @default(0)
  high    Float    @default(0)
  low     Float    @default(0)
  close   Float    @default(0)
  volume  Float    @default(0)
  priceRef Price   @relation(fields: [priceId], references: [id], onDelete: Cascade)

  @@index([priceId, date])
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?
  content         String
  category        String?
  tags            String[]
  coverImage      String?
  isAiGenerated   Boolean       @default(false)
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String[]
  publishedAt     DateTime?
  viewCount       Int           @default(0)
  status          ArticleStatus @default(draft)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
}

model Ad {
  id              String       @id @default(cuid())
  title           String
  type            AdType
  position        AdPosition
  imageUrl        String?
  linkUrl         String?
  htmlCode        String?
  isActive        Boolean      @default(true)
  startDate       DateTime?
  endDate         DateTime?
  priority        Int          @default(0)
  impressionCount Int          @default(0)
  clickCount      Int          @default(0)
  deviceTarget    DeviceTarget @default(all)
  pageTarget      String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  impressions     AdImpression[]

  @@index([isActive, position])
  @@index([pageTarget])
}

model AdImpression {
  id        String   @id @default(cuid())
  adId      String
  ip        String
  userAgent String?
  page      String
  timestamp DateTime @default(now())
  isClick   Boolean  @default(false)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, timestamp])
  @@index([ip, timestamp])
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  ip        String
  userAgent String?
  referrer  String?
  country   String?
  city      String?
  device    String?
  browser   String?
  timestamp DateTime @default(now())
  sessionId String?

  @@index([page, timestamp])
  @@index([ip, timestamp])
  @@index([sessionId])
}

model DailyStats {
  id             String   @id @default(cuid())
  date           DateTime @unique
  totalViews     Int      @default(0)
  uniqueVisitors Int      @default(0)
  topPages       Json?
  topReferrers   Json?
  createdAt      DateTime @default(now())

  @@index([date])
}

model SeoMeta {
  id           String   @id @default(cuid())
  page         String   @unique
  title        String?
  description  String?
  keywords     String[]
  canonicalUrl String?
  ogImage      String?
  schema       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([page])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(editor)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String    @id @default(cuid())
  priceSlug String
  author    String
  email     String
  text      String
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())

  @@index([priceSlug, createdAt])
  @@index([email, createdAt])
  @@index([parentId])
  @@map("comments")
}
